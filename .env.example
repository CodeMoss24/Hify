# ============================================================
# Hify 环境变量模板
# 复制为 .env 后修改实际值
#   cp .env.example .env
# ============================================================

# ============================================================
# MySQL（Docker内部通过 service name 通信）
# ============================================================
DB_HOST=mysql
DB_PORT=3306
DB_NAME=hify
DB_USERNAME=root
DB_PASSWORD=<改成你自己的密码>

# ============================================================
# Redis
# ============================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ============================================================
# Qdrant 向量数据库
# ============================================================
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# ============================================================
# 服务端口
# ============================================================
APP_HOST=0.0.0.0
APP_PORT=8000
BACKEND_PORT=8000
FRONTEND_PORT=80

# ============================================================
# LLM Provider 超时（秒）
# ============================================================
LLM_TIMEOUT=120
LLM_CONNECT_TIMEOUT=10

# ============================================================
# LLM 并发控制
# ============================================================
LLM_CHAT_CONCURRENCY=10
BACKGROUND_CONCURRENCY=5

# ============================================================
# Embedding 配置（根据使用的服务商，取消对应行的注释并填入真实值）
# ============================================================

# --- 火山引擎（豆包）Embedding ---
# ARK_EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/plan/v3
# ARK_EMBEDDING_MODEL=doubao-embedding-vision
# ARK_EMBEDDING_API_KEY=<填入API Key>
# ARK_EMBEDDING_BATCH_SIZE=4
# ARK_EMBEDDING_DIMENSION=1024

# --- DeepSeek Embedding ---
# ARK_EMBEDDING_BASE_URL=https://api.deepseek.com/v1
# ARK_EMBEDDING_MODEL=deepseek-embedding
# ARK_EMBEDDING_API_KEY=<填入API Key>
# ARK_EMBEDDING_BATCH_SIZE=4
# ARK_EMBEDDING_DIMENSION=1024
